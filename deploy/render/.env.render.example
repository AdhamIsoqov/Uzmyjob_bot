# Render.com Environment Variables (Namuna)
# Ushbu o'zgaruvchilar Render boshqaruv panelida (Dashboard -> Environment) sozlanadi:

BOT_TOKEN=your_telegram_bot_token
GEMINI_API_KEY=your_gemini_api_key

# Eslatma: Quyidagi buyruq orqali 32-baytli base64 kalit yarating:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_32_byte_base64_fernet_key

# Render Managed PostgreSQL 'Internal Database URL' manzili:
DATABASE_URL=postgresql://uzmyjob:password@dpg-xxxxxx-a.frankfurt-postgres.render.com/uzmyjob

# Render Web Service manzili va Webhook maxfiy kaliti (kamida 16 belgi):
WEBHOOK_URL=https://uzmyjob-bot.onrender.com
WEBHOOK_SECRET=your_super_secret_webhook_token_min_16_chars

# Qo'shimcha parametrlar:
POLL_INTERVAL_MINUTES=15
MATCH_THRESHOLD=0.55
LLM_RERANK_THRESHOLD=0.40
GEMINI_MONTHLY_COST_LIMIT_USD=5.0
THROTTLE_RATE=30
