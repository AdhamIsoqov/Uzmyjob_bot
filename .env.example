# Majburiy sozlamalar (Production va Local)
BOT_TOKEN=your_telegram_bot_token
GEMINI_API_KEY=your_gemini_api_key
FERNET_KEY=generate_with_Fernet_generate_key

# Ma'lumotlar bazasi (PostgreSQL yoki local dev uchun SQLite)
POSTGRES_URL=postgresql+asyncpg://uzmyjob:password@localhost:5432/uzmyjob

# Telegram Webhook (Production uchun majburiy, bo'sh qoldirilsa Polling ishlaydi)
WEBHOOK_URL=
WEBHOOK_SECRET=

# HTTP Server porti (Render avtomatik PORT beradi)
PORT=8080

# HeadHunter (hh.uz) OAuth2 integratsiyasi (ixtiyoriy)
HH_CLIENT_ID=
HH_CLIENT_SECRET=

# Scheduler va Matching parametrlari
POLL_INTERVAL_MINUTES=15
MATCH_THRESHOLD=0.55
LLM_RERANK_THRESHOLD=0.40
GEMINI_MONTHLY_COST_LIMIT_USD=5.0
THROTTLE_RATE=30

# Email orqali ariza yuborish (ixtiyoriy)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
