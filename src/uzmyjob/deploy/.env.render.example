# Render.com Environment Variables (Namuna)
# Ushbu o'zgaruvchilar Render boshqaruv panelida (Dashboard -> Environment) sozlanadi:

BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
GEMINI_API_KEY=AIzaSy...
# Render generatsiya qiladi yoki: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=YOUR_32_BYTE_BASE64_KEY

# Render Managed PostgreSQL 'Internal Database URL' manzili:
DATABASE_URL=postgres://uzmyjob:password@dpg-xxxxxx-a.frankfurt-postgres.render.com/uzmyjob

# Render Web Service manzili:
WEBHOOK_URL=https://uzmyjob-bot.onrender.com
WEBHOOK_SECRET=your_super_secret_webhook_token

# Qo'shimcha parametrlar:
PYTHON_VERSION=3.12.4
POLL_INTERVAL_MINUTES=15
MATCH_THRESHOLD=0.55
